# CONFIG_DATLINK_ROLE_GATEWAY is not set
CONFIG_DATLINK_ROLE_PROBE=y
CONFIG_DATLINK_WIFI_CHANNEL=1
CONFIG_DATLINK_SWD_CLK_GPIO=4
CONFIG_DATLINK_SWD_IO_GPIO=5
CONFIG_DATLINK_SWD_RESET_GPIO=6
CONFIG_DATLINK_TARGET_VREF_GPIO=1
CONFIG_DATLINK_SWD_INITIAL_KHZ=100
# The gateway_usb component is compiled by ESP-IDF for dependency validation,
# but Probe never installs the TinyUSB driver at runtime.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
